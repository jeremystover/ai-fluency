{
  "name": "fluency-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "seed:generate": "node scripts/generate-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply fluency-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply fluency-demo --remote",
    "db:seed:local": "wrangler d1 execute fluency-demo --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute fluency-demo --remote --file=./seed/seed.sql",
    "start": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "maintain": "node scripts/maintenance-agent.mjs",
    "maintain:write": "node scripts/maintenance-agent.mjs --write"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "marked": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@fontsource-variable/outfit": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.22.0"
  }
}
