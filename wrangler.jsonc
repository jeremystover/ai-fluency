{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluency-demo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first, which falls through to ASSETS
    // for anything it doesn't handle (see app.notFound). A path list was the
    // narrower option, but OAuth discovery lives at fixed well-known paths
    // outside /api, and if asset routing wins there the SPA answers discovery
    // with index.html and every connector fails at a step that looks like a
    // server outage. Correctness over shaving a hop on static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fluency-demo",
      // Replace with the real database id after `wrangler d1 create fluency-demo`.
      "database_id": "bc317eea-1f6e-4945-99cf-82edf954b0cb",
      "migrations_dir": "drizzle"
    }
  ],
  // Podcast text-to-speech (@cf/deepgram/aura-1) runs on Workers AI — no extra vendor account.
  // Note: with this binding present, `wrangler dev` needs a logged-in Cloudflare account
  // (Workers AI has no local simulator). Remove this block to run fully offline —
  // the podcast studio degrades to transcript-only.
  "ai": {
    "binding": "AI"
  },
  // Keeps every open module's stock podcast episode baked ahead of arrival —
  // steady-state runs are a handful of D1 reads and bake nothing.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // Rendered episode audio cache. Create with `wrangler r2 bucket create fluency-demo-audio`.
  "r2_buckets": [
    {
      "binding": "PODCAST_AUDIO",
      "bucket_name": "fluency-demo-audio"
    }
  ],
  "vars": {
    // One brand active per deployment. Change to another fd_brand slug to re-skin.
    "BRAND_SLUG": "omnissa",
    // Which AI tool stack this org provisions. The [V] lab lessons ship in
    // variants; this picks which one every surface serves (reading view, micro,
    // tutor chat, podcast). "claude" (default) | "chatgpt". Change + redeploy —
    // no reseed needed, all variants are already in the database.
    "ORG_TOOLING": "claude",
    // Model used for applied-activity grading; persisted on fd_submission.
    "GRADING_MODEL": "claude-sonnet-5",
    // Model behind the module tutor chat; persisted on fd_chat_message.
    "CHAT_MODEL": "claude-opus-5",
    // Model used to write podcast scripts; persisted on fd_podcast.
    "PODCAST_MODEL": "claude-sonnet-5",
    // Episode scripts per session per hour (default 4 if unset). Raised for demo/testing.
    "PODCAST_LIMIT_PER_HOUR": "12",
    // Gemini TTS model used when the GEMINI_API_KEY secret is set (multi-speaker).
    "GEMINI_TTS_MODEL": "gemini-3.1-flash-tts-preview"
  }
  // AUTH_MODE is deliberately unset here, so this deployment runs the passcode
  // demo door. Set it to "accounts" to run the product door — census-gated
  // email + password sign-up, progress following the account across devices,
  // and the manager view at /team (which needs a real identity: authorization
  // is exact-email against fd_employee.manager_email, and passcode sessions are
  // anonymous). Flip it only once the census is imported — sign-up is gated on
  // that roster, so an empty census with AUTH_MODE=accounts means nobody can
  // get in at all.

  // Secrets (set with `wrangler secret put`):
  //   SESSION_SECRET      — HMAC key for session cookie signing
  //   ANTHROPIC_API_KEY   — grading + tutor chat + podcast scripts; never exposed to the client
  //   GEMINI_API_KEY      — optional: voices podcast chunks with Gemini's native
  //                         multi-speaker TTS instead of Aura (Aura stays the fallback)
  //   RESEND_API_KEY      — optional: sends reminders, kudos, and commitment mail.
  //                         Unset, every rule still evaluates and each intended
  //                         send is logged as 'skipped' — nothing is pretended.
  //   EMAIL_FROM          — the verified sender, e.g. "AI Fluency <learn@acme.com>"
}
